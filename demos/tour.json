{
  "//": "Product tour for the README and the site. Records through the Vite dev server (:5173, proxying the API on :8790), because the production CSP blocks the recorder's overlay. Re-record: node <demo-recorder>/scripts/demo.mjs record demos/tour.json",
  "name": "tour",
  "url": "http://localhost:5173/#/scan",
  "viewport": "desktop",
  "theme": "dark",
  "intro": {
    "title": "Airchitect",
    "subtitle": "Get the app you built online, safely",
    "duration": 2200
  },
  "steps": [
    {
      "caption": "Is your app leaking anything?",
      "type": "github.com",
      "into": "#scan-url"
    },
    {
      "click": {
        "role": "button",
        "name": "Check it"
      }
    },
    {
      "waitFor": {
        "text": "Security report"
      },
      "cut": true
    },
    {
      "expect": {
        "text": "This looks well protected."
      }
    },
    {
      "zoom": ".grade",
      "hold": 1500,
      "mark": "scan",
      "optional": true
    },
    {
      "wait": 900
    },
    {
      "caption": "Find the cloud that fits your budget",
      "click": "a[href='#/quote']",
      "after": 800
    },
    {
      "check": {
        "label": "European companies only"
      },
      "optional": true,
      "after": 900
    },
    {
      "expect": {
        "text": "Balanced"
      }
    },
    {
      "zoom": {
        "text": "Our pick"
      },
      "hold": 1600,
      "mark": "quote",
      "optional": true
    },
    {
      "caption": "Turn a repo into a hardened server",
      "click": "a[href='#/rescue']",
      "after": 600
    },
    {
      "type": "https://github.com/steven-tey/precedent",
      "into": "#repo-url",
      "paste": true
    },
    {
      "click": {
        "role": "button",
        "name": "Rescue it"
      }
    },
    {
      "waitFor": {
        "text": "Project report"
      },
      "cut": true,
      "timeout": 60000
    },
    {
      "expect": {
        "text": "We know how to run this."
      }
    },
    {
      "scroll": {
        "text": "Your files"
      },
      "after": 1600,
      "mark": "rescue"
    },
    {
      "caption": "Then keep an eye on it",
      "click": "a[href='#/watch']",
      "after": 600
    },
    {
      "type": "example.com",
      "into": "#watch-url"
    },
    {
      "click": {
        "role": "button",
        "name": "Watch it"
      }
    },
    {
      "waitFor": {
        "text": "First check passed"
      },
      "cut": true,
      "timeout": 30000
    },
    {
      "zoom": {
        "text": "Uptime"
      },
      "hold": 1500,
      "mark": "watch",
      "optional": true
    },
    {
      "caption": null,
      "wait": 500
    },
    {
      "//": "clean up the dev watch list, kept out of the video",
      "click": {
        "role": "button",
        "name": "Stop watching"
      },
      "cut": true
    }
  ],
  "outro": {
    "title": "Airchitect",
    "subtitle": "Source available, free for non-commercial use",
    "duration": 2200
  },
  "exports": [
    {
      "file": "tour.mp4"
    },
    {
      "file": "tour.gif",
      "width": 800,
      "fps": 10,
      "trim": [
        "#1",
        "watch@end"
      ]
    },
    {
      "file": "tour-poster.jpg",
      "at": "scan"
    }
  ],
  "blur": [
    ".token code"
  ]
}
